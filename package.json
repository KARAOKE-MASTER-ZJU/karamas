{
  "name": "karamas-workspace",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --dir app dev",
    "check": "pnpm --dir app check",
    "build": "pnpm --dir app build",
    "preview": "pnpm --dir app preview",
    "tauri": "pnpm --dir app tauri",
    "android": "pnpm --dir app android",
    "version:set": "node app/scripts/set-version.mjs",
    "lint": "pnpm --dir app lint",
    "lint:fix": "pnpm --dir app lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt:rust": "cargo fmt -p karamas",
    "fmt:rust:check": "cargo fmt -p karamas --check",
    "prepare": "husky",
    "check:all": "pnpm lint && pnpm format:check && pnpm check && pnpm fmt:rust:check",
    "fix:all": "pnpm lint:fix && pnpm format && pnpm fmt:rust"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.9.10"
  }
}
